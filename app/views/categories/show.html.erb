<h1><%= @category.category_name %></h1>
<p><%= @category.description %></p>

<%= link_to 'Edit', edit_category_path(@category) %> |
<%= link_to 'Delete Category', category_path(@category), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  } %> |
<%= link_to 'Back to Home', pages_index_path %>

<div style="padding-left:30px">
  <div>
    <p>Add a task for <%= @category.category_name %>:</p>
    
    <%= render "tasks/form", category: @category, task: @task %>
  </div>

  <div style="padding:20px">
    <h3 style="color:red">Tasks:</h3>

    <% saved_tasks = @category.tasks.select(&:persisted?) %>
    <% if saved_tasks.any? %>
      <ul>
        <% saved_tasks.each do |task| %>
          <li>
            <strong><%= task.task_name %></strong> - <%= task.description %> |
            Due: <%= task.due_date ? task.due_date.strftime("%b %d, %Y") : "No due date" %> |
            Completed: <%= task.completed ? "Yes" : "No" %> <br>

            <%= link_to 'View task', category_task_path(@category, task) %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No tasks yet for this category.</p>
    <% end %>
  </div>
</div>
